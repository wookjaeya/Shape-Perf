@@ -222,7 +223,55 @@ void populateAffineAndKrnlToLLVMConversion(RewritePatternSet &patterns,
   memref::populateExpandOpsPatterns(patterns);
   // Use polynomial approximation for math.{tanh, sin, cos and exp} for better
