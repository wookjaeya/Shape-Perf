   83  void OS_Lock_Global_Impl(osal_objtype_t idtype)
   84  {
   85      OS_impl_objtype_lock_t *impl;
   86      int                     ret;
   87  
   88      impl = OS_impl_objtype_lock_table[idtype];
   89  
   90      if (impl != NULL)
   91      {
   92          ret = pthread_mutex_lock(&impl->mutex);
   93          if (ret != 0)
   94          {
   95              OS_DEBUG("pthread_mutex_lock(&impl->mutex): %s", strerror(ret));
   96          }
   97      }
   98  }
   99  
  100  /*----------------------------------------------------------------
  101   *
  102   *  Purpose: Implemented per internal OSAL API
  103   *           See prototype for argument/return detail
  104   *
  105   *-----------------------------------------------------------------*/
  106  void OS_Unlock_Global_Impl(osal_objtype_t idtype)
  107  {
  108      OS_impl_objtype_lock_t *impl;
  109      int                     ret;
  110  
  111      impl = OS_impl_objtype_lock_table[idtype];
  112  
  113      if (impl != NULL)
  114      {
  115          /* Notify any waiting threads that the state _may_ have changed */
  116          ret = pthread_cond_broadcast(&impl->cond);
  117          if (ret != 0)
  118          {
  119              OS_DEBUG("pthread_cond_broadcast(&impl->cond): %s", strerror(ret));
  120              /* unexpected but keep going (not critical) */
  121          }
  122  
  123          ret = pthread_mutex_unlock(&impl->mutex);
  124          if (ret != 0)
  125          {
  126              OS_DEBUG("pthread_mutex_unlock(&impl->mutex): %s", strerror(ret));
  127          }
  128      }
  129  }
