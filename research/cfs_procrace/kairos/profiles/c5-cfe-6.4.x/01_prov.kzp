# 01_prov.kzp -- the cited texts of profile c5-cfe-6.4.x that are the same in both releases: OSAL 4.1.1 (one tarball
# for both) and the cFE lines that are identical, at the same line numbers, in the 6.4.1 and 6.4.2 trees (compared for
# this profile; where the whole file is byte-identical the note says so).
#
# Paths are relative to the root of a release tree, cFE-6.4.<V>-OSS-release/ with osal-4.1.1-release at osal/.  Each
# sha256 is that of the cited lines, each followed by LF (`sed -n 'A,Bp' FILE | sha256sum`), computed from both trees
# for this profile; nothing is quoted from memory.
phi 1;

prov osal_task_create_sig {
  tier code-derived;
  kind code_pattern;
  file "osal/src/os/posix/osapi.c";
  lines 480 482;
  sha256 "954a73d179d1d107190dea8146bc1206519c894f73758c5198a200e1a9ade954";
  note "OS_TaskCreate(task_id, task_name, function_pointer, stack_pointer, stack_size, priority, flags) of OSAL 4.1.1 posix: the new task's id is returned through the first parameter";
}

prov osal_pthread_create_cell {
  tier code-derived;
  kind code_pattern;
  file "osal/src/os/posix/osapi.c";
  lines 645 648;
  sha256 "b317c297d4b89a7d2074c9872dd850fb16580c17bd6246d5da664208d99322b9";
  note "pthread_create(&(OS_task_table[possible_taskid].id), &custom_attr, function_pointer, (void *)0): the new thread may run from here; the output argument is the task-table cell; the application's entry function is started directly (no OSAL entry wrapper, no id argument)";
}

prov osal_task_id_out {
  tier code-derived;
  kind code_pattern;
  file "osal/src/os/posix/osapi.c";
  lines 690 690;
  sha256 "a72eedafee1b57ac8b91e34748b0a45840c3fb92950b2fc5820bd874c215e7e5";
  note "*task_id = possible_taskid: the creator receives the new task's id only after pthread_create (L645-L648)";
}

prov osal_task_register {
  tier code-derived;
  kind code_pattern;
  file "osal/src/os/posix/osapi.c";
  lines 906 948;
  sha256 "4bbb05a608fbd536745f5e58184ddac3dcb6c4fcd91c830faaea80ccc835d14d";
  note "OS_TaskRegister: pthread_self() (L916) compared with each OS_task_table[i].id, without a lock and without looking at free (L921-L927); none found: OS_ERR_INVALID_ID (L932) and no pthread_setspecific; found: pthread_setspecific(thread_key, task_id) (L938)";
}

prov osal_task_getid {
  tier code-derived;
  kind code_pattern;
  file "osal/src/os/posix/osapi.c";
  lines 959 972;
  sha256 "60ffdd9acdc1db9cc6a800afcd5f91bad4a6e9e1f31e75e543523e74366e67b6";
  note "OS_TaskGetId: the low 16 bits of the thread-specific value that OS_TaskRegister set; 0 when it was never set";
}

