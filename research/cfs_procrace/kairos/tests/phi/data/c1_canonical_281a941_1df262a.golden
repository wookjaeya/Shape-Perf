source bp root "bp" rev "b051eb0d12bfe76c0230215c2ff851cfaa553ce4";
source cf root "cf" rev "281a94188cd7d885a5aed01ee041f3ece2b0486f";
source cfe root "cfe" rev "6cccb3f5d10664b5b10aeb9cfcda871ba2d99b32";
source osal root "osal" rev "f34759d6d6f7087e81afda94eccf7554e013cbe6";
const CFE_ES_APPID_BASE = 0x110000 prov osal_index_mask_shift, osal_type_user, resid_appid_base, resid_appid_offset, resid_make_base, resid_mark_simple, resid_mode_cmake note "SIMPLE resource-ID mode; a STRICT build has 0x02110000";
const CFE_ES_RunStatus_APP_ERROR = 3 prov es_runstatus_app_error;
const CFE_PLATFORM_ES_MAX_APPLICATIONS = ref eval "CFE_PLATFORM_ES_MAX_APPLICATIONS" in "cfe/modules/es/fsw/src/cfe_es_start.c" prov es_start_table_loop;
const CFE_RESOURCEID_MAX = 65535 prov osal_index_mask_shift, resid_max_def;
const CFE_RESOURCEID_RESERVED = 0xffffffff prov resid_reserved_def;
const CFE_RESOURCEID_UNDEFINED = 0 prov resid_undefined_def;
const CF_CHANNEL_0_SEM_NAME = "BP0_tsem" prov bp_cfg_rx_ch0_name, bp_cfg_tx_ch0_name, bp_semcfg_names;
const CF_CHANNEL_1_SEM_NAME = "BP1_tsem" prov bp_cfg_rx_ch1_name, bp_cfg_tx_ch1_name, bp_semcfg_names;
const OS_ERROR = -1 prov osal_err_error;
const OS_ERR_NAME_NOT_FOUND = -17 prov osal_err_name_not_found;
const OS_ERR_NAME_TAKEN = -15 prov osal_err_name_taken;
const OS_ERR_NAME_TOO_LONG = -13 prov osal_err_name_too_long;
const OS_ERR_NO_FREE_IDS = -14 prov osal_err_no_free_ids;
const OS_INVALID_POINTER = -2 prov osal_err_invalid_pointer;
const OS_INVALID_SEM_VALUE = -20 prov osal_err_invalid_sem_value;
const OS_SEM_FAILURE = -6 prov osal_err_sem_failure;
const OS_SUCCESS = 0 prov osal_err_success;
context {
  owner_kind es.app;
  prov es_start_table_loop;
}
kind es.app(rec: Int) {
  states FREE < RESERVED < LIVE;
  initial FREE;
  scope process;
  table CFE_PLATFORM_ES_MAX_APPLICATIONS;
  ids {
    undefined CFE_RESOURCEID_UNDEFINED;
    reserved CFE_RESOURCEID_RESERVED;
    base CFE_ES_APPID_BASE;
    serial_max CFE_RESOURCEID_MAX;
  }
  prov es_start_table_loop, resid_appid_base, resid_max_def, resid_reserved_def, resid_undefined_def;
}
kind osal.countsem(name: Str) {
  states ABSENT < LIVE;
  initial ABSENT;
  scope process;
  transition ABSENT -> LIVE on create;
  transition LIVE -> ABSENT on delete;
  prov bp_flow_throttle_init, bp_semcfg_table, osal_countsem_create_def, osal_countsem_finalize, osal_countsem_getidbyname_def, osal_delete_all, osal_find_by_name, r_countsem_by_name;
}
site bp_create_call = fn("initialize_throttling").call("OS_CountSemCreate") prov bp_flow_create_call;
site bp_existence_probe_call = fn("initialize_throttling").call("OS_CountSemGetIdByName") prov bp_flow_lookup_call;
site cf_lookup_call = fn("CF_CFDP_InitEngine").call("OS_CountSemGetIdByName") prov cf_cfdp_lookup_call;
role bp-existence-probe {
  op OS_CountSemGetIdByName;
  site bp_existence_probe_call;
  purpose existence_probe;
  prov bp_flow_create_call, bp_flow_lookup_call, bp_flow_throttle_init, bp_semcfg_purpose, r_role_binding;
}
role cf-dependent-lookup {
  op OS_CountSemGetIdByName;
  site cf_lookup_call;
  purpose dependent_use;
  prov cf_cfdp_lookup, cf_dox_flow_control, cf_events_sem_eid, issue_184_body, r_role_binding;
}
op BP_FlowInit(AppName) {
  bind symbol "BP_FlowInit";
  prov bp_flowinit_calls_throttle;
}
op CFE_ES_ExitApp(ExitStatus) {
  bind symbol "CFE_ES_ExitApp";
  prov bp_app_main_exit, cf_app_exit, es_exitapp_sig;
}
op CF_CFDP_InitEngine() {
  bind symbol "CF_CFDP_InitEngine";
  prov cf_app_init_engine_call, cf_cfdp_initengine_return;
}
op CF_Init() {
  bind symbol "CF_Init";
  prov cf_app_init_status;
}
op OS_CountSemCreate(out sem_id, sem_name: Str, sem_initial_value, options) {
  bind symbol "OS_CountSemCreate";
  effect publish: lifecycle osal.countsem(arg.sem_name) -> LIVE filter lp.operation_status = OS_SUCCESS lp at fn("OS_CountSemCreate").call("OS_ObjectIdFinalizeNew") values operation_status: Int prov osal_countsem_create_def, osal_countsem_finalize;
  outcome OS_ERR_NAME_TAKEN: error documented "retval OS_ERR_NAME_TAKEN of OS_CountSemCreate: already the name of a counting semaphore" prov osal_countsem_h_create;
  outcome OS_ERR_NAME_TOO_LONG: error documented "retval OS_ERR_NAME_TOO_LONG of OS_CountSemCreate" prov osal_countsem_h_create;
  outcome OS_ERR_NO_FREE_IDS: error documented "retval OS_ERR_NO_FREE_IDS of OS_CountSemCreate" prov osal_countsem_h_create;
  outcome OS_INVALID_POINTER: error documented "retval OS_INVALID_POINTER of OS_CountSemCreate" prov osal_countsem_h_create;
  outcome OS_INVALID_SEM_VALUE: error documented "retval OS_INVALID_SEM_VALUE of OS_CountSemCreate" prov osal_countsem_h_create;
  outcome OS_SEM_FAILURE: error documented "retval OS_SEM_FAILURE of OS_CountSemCreate" prov osal_countsem_h_create;
  outcome OS_SUCCESS: ready;
  prov osal_countsem_create_def, osal_countsem_h_create;
}
op OS_CountSemGetIdByName(out sem_id, key sem_name: Str) {
  bind symbol "OS_CountSemGetIdByName";
  conjunct exists: state(osal.countsem(arg.sem_name)) = LIVE lp at fn("OS_CountSemGetIdByName").call("OS_ObjectIdFindByName") prov osal_countsem_getidbyname_def, osal_find_by_name;
  outcome OS_ERR_NAME_NOT_FOUND: not_ready(exists) documented "retval OS_ERR_NAME_NOT_FOUND of OS_CountSemGetIdByName: the name was not found in the table" prov osal_countsem_h_getidbyname;
  outcome OS_ERR_NAME_TOO_LONG: error documented "retval OS_ERR_NAME_TOO_LONG of OS_CountSemGetIdByName" prov osal_countsem_h_getidbyname;
  outcome OS_INVALID_POINTER: error documented "retval OS_INVALID_POINTER of OS_CountSemGetIdByName" prov osal_countsem_h_getidbyname;
  outcome OS_SUCCESS: ready;
  prov osal_countsem_getidbyname_def, osal_countsem_h_getidbyname;
}
op OS_TaskCreate(out task_id, task_name, function_pointer, stack_pointer, stack_size, priority, flags) {
  bind symbol "OS_TaskCreate";
  prov osal_task_create_def;
}
op OS_TaskEntryPoint(task_id) {
  bind symbol "OS_TaskEntryPoint";
  prov osal_pthread_entry, osal_task_entry_def;
}
hb R1 {
  title "program order";
  stratum S;
  robust unconditional;
  template program_order {
    looper yes;
  }
  prov r_axiom_program_order;
}
hb R2-P-TASK {
  title "task creation: the creating call precedes the first event of the child";
  stratum S;
  robust unconditional;
  template spawn {
    create OS_TaskCreate out task_id;
    entry OS_TaskEntryPoint;
  }
  prov osal_pthread_entry, osal_task_create_def, osal_task_entry_def;
}
rspec K-REG.osal-countsem-lookup {
  use op OS_CountSemGetIdByName;
  key osal.countsem(arg.sem_name);
  requires state(osal.countsem(arg.sem_name)) = LIVE;
  oracle fns "OS_ObjectIdFindByName", "OS_ObjectNameMatch";
  appreq unspecified_by_reference;
  allowed unspecified_by_reference;
  harm app_error_exit;
  authored "2026-10-24, C1 profile, from SPEC_FINAL rev 1.3 1.6, 2.3 and App. A.4 steps 3 and 6, plan/C1_basis_plan.md 9.3, 9.7, 9.8; cases inspected: C1";
  prov cf_app_exit, cf_app_init_status, cf_cfdp_lookup, cf_dox_flow_control, cf_events_sem_eid, issue_184_body, osal_countsem_h_getidbyname;
}
