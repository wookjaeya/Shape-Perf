# hold.kzp -- the observation profile of the hold test program (hold_prog.c), used by the
# `kz hold` integration test.  Unit-test values: not a framework profile and not a research
# condition (CONDITIONS_POLICY).  The gate reads the name argument (second argument, rsi) as a
# string from the stopped thread's memory; no tracefs is needed for a hold (ptrace reads it).
kzp-observe 1
binary hold_prog

prov hp_create tier=researcher kind=researcher file="tests/cfs-free/target/hold_prog.c" lines=36-49 cite="hp_obj_create(id_out, name, initial): the gate entry; name is the second argument" authored="K2, hold tests"
prov hp_lookup tier=researcher kind=researcher file="tests/cfs-free/target/hold_prog.c" lines=52-62 cite="hp_obj_lookup(id_out, name)" authored="K2, hold tests"
prov hp_done   tier=researcher kind=researcher file="tests/cfs-free/target/hold_prog.c" lines=65-68 cite="hp_consumer_done(found, attempts): the release event" authored="K2, hold tests"

site obj.create.entry entry func=hp_obj_create prov=hp_create s0=rdi:u64:id_out_ptr s1=+0(rsi):string:name s3=stack+0:u64:return_address
site obj.create.ret   ret   func=hp_obj_create prov=hp_create s0=rax:u32:status s3=ip:u64:return_address
site obj.lookup.entry entry func=hp_obj_lookup prov=hp_lookup s0=rdi:u64:id_out_ptr s1=+0(rsi):string:name s3=stack+0:u64:return_address
site consumer.done.entry entry func=hp_consumer_done prov=hp_done s0=rdi:u32:found s3=stack+0:u64:return_address
