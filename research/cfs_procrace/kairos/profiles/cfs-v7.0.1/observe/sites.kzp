# ---- R2 remainder: the location the passed AppID was read from, and its writer (2026-10-24) -------------
#
# The value the SB call sites pass as AppID is loaded from CFE_SB_Global.AppId in the same statement (the static
# derives of the pinned bundle: the AppID argument at cfe_sb_api.c:277:50, :1185:50 and cfe_sb_priv.c:786:70 is
# CFE_SB_Global_t.AppId with hops 0, kairos/tests/static/data/core_cpu1.golden lines 503, 525, 532).  At the
# call instruction (at-call) rdx holds that argument (System V x86-64, third argument); the slot role
# value(CFE_SB_Global.AppId) names the location for the replay (`cell`).  The labels are the capture point of
# the profile, CFE_EVS_SendEventWithAppID.id_valid, with '@' and the call site (a plan label is unique).
prov sb_api_pipe_event tier=code-derived kind=code_pattern file="cfe/modules/sb/fsw/src/cfe_sb_api.c" lines=275-277 cite="CFE_SB_CreatePipe's debug event: CFE_EVS_SendEventWithAppID(CFE_SB_PIPE_ADDED_EID, CFE_EVS_EventType_DEBUG, CFE_SB_Global.AppId, ...)" sha256=e6e4f79f9ed774e777bc817259d86cbffcf2903f7d625d4a935c76da329874b3
prov sb_api_sub_event tier=code-derived kind=code_pattern file="cfe/modules/sb/fsw/src/cfe_sb_api.c" lines=1183-1185 cite="CFE_SB_SubscribeFull's debug event: CFE_EVS_SendEventWithAppID(CFE_SB_SUBSCRIPTION_RCVD_EID, CFE_EVS_EventType_DEBUG, CFE_SB_Global.AppId, ...)" sha256=4c888b7ea9a929d63d26c9ef7dbc463d8dcf4696a7142179242d9045c38f0a10
prov sb_priv_report_event tier=code-derived kind=code_pattern file="cfe/modules/sb/fsw/src/cfe_sb_priv.c" lines=786-786 cite="CFE_SB_MessageTxn_ReportSingleEvent: CFE_EVS_SendEventWithAppID(EventId, EventType, CFE_SB_Global.AppId, \"%s\", Message)" sha256=fae9472a7b6b3bf2d9038868a4af1de25005457200cc798e67da9a6634935f4b

# The SB task's store of its own id through CFE_ES_GetAppID's out parameter (the profile's site sb_publication:
# fn("CFE_SB_AppInit").call("CFE_ES_GetAppID", arg[0] is addr(CFE_SB_Global_t.AppId))).  After the call: the
# store has happened on either branch of CFE_ES_GetAppID; the stored value is not read here.
site sb_publication point at=cfe_sb_task.c:138 after-call=CFE_ES_GetAppID prov=sb_task_138 s0=rax:u32:status
