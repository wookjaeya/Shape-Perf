  tier code-derived;
  kind code_pattern;
  file "osal/src/os/shared/src/osapi-idmap.c";
  lines 118 123;
  sha256 "a2a838996c06fdb7b9ae15ddeb5c2fa326758e44c1faa74b4a351c6d77f5be71";
  note "OS_ObjectIdInit: memset of the whole OS_common_table (every record of every object type: active_id, name_entry and creator zero) and of the per-type state";
}

