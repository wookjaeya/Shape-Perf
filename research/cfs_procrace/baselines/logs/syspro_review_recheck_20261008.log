## 6. Syscalls of the PSP/OSAL calls that run in a new core-app thread before its main, on this glibc (probe, not cFS)
/* Which syscalls do the PSP/OSAL calls that run in a new cFE core-app thread before its main issue on this glibc? (probe, not cFS) */
#define _GNU_SOURCE
#include <pthread.h>
#include <sched.h>
#include <signal.h>
#include <time.h>
#include <unistd.h>
#include <sys/syscall.h>
static void h(int s, siginfo_t *i, void *c) { (void)s; (void)i; (void)c; }
int main(void) {
    cpu_set_t cpuset; struct sigaction sa = {0}; struct timespec ts;
    syscall(39); /* marker */
    CPU_ZERO(&cpuset); CPU_SET(0, &cpuset);
    pthread_setaffinity_np(pthread_self(), sizeof(cpuset), &cpuset); /* cfe_psp_start.c:188 (CFE_* task names) */
    syscall(39); /* marker */
    pthread_setname_np(pthread_self(), "CFE_SB");                     /* cfe_psp_start.c:201 */
    syscall(39); /* marker */
    clock_gettime(CLOCK_MONOTONIC, &ts); ts.tv_nsec += 1000000; if (ts.tv_nsec >= 1000000000) { ts.tv_nsec -= 1000000000; ts.tv_sec++; }
    clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, NULL);       /* os-impl-tasks.c:761 (OS_TaskDelay_Impl) */
    syscall(39); /* marker */
    sa.sa_sigaction = h; sa.sa_flags = SA_SIGINFO;
    sigaction(SIGFPE, &sa, NULL);                                      /* cfe_psp_exception.c:179 via L266 */
    syscall(39); /* marker */
    return 0;
}
