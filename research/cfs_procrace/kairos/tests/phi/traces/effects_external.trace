# effects_external -- the life cycle of an external application, and the refutation checks of the
# asserted effect guards.  The effects guarded by Type = EXTERNAL can only apply to a record that
# CFE_ES_AppCreate tagged; the cleanup retires the record (LIVE -> RESERVED) before it frees it.
#
# Unit-test values only: nothing here is a recorded run and no value is a research condition.
#
#   slot 1  an external application: AppCreate clears the record, tags it EXTERNAL, reserves it and
#           publishes it; the task runs (RUNNING); the background scan moves it to WAITING; its exit
#           marks it STOPPED; the cleanup retires the record (RESERVED), then frees it (FREE)
#   slot 2  a core application.  The trace shows points that the code never reaches for it: the scan
#           store, the exit store, the cleanup retire and the cleanup free.  Each guard is false in the
#           replay, so each point is a finding and a guard failure, and nothing is applied: three are
#           trace/profile disagreements, and the retire is a refutation of its declared-trusted guard
#           (refutable_by O3, O4)
#   slot 3  an external application whose start fails: reserved and tagged, then freed again; the
#           task that belonged to it shows the exit store although its record is not live, which is a
#           disagreement as well
const CFE_PLATFORM_ES_MAX_APPLICATIONS 4
owner T_EXT 1
owner T_CORE 2
owner T_EXT2 3

T0 CFE_ES_CreateObjects.reserve_core pt lp.slot=2
T0 CFE_ES_CreateObjects.type_core pt lp.slot=2
T0 CFE_ES_CreateObjects.publish_core pt lp.slot=2 lp.pending_id=0x110002
T_CORE CFE_ES_RunLoop call arg.RunStatus=1
T_CORE CFE_ES_RunLoop.raise_running pt
T_CORE CFE_ES_RunLoop ret result=1

T0 CFE_ES_AppCreate call
T0 app_create_clear pt lp.slot=1
T0 CFE_ES_AppCreate.type_external pt lp.slot=1
T0 CFE_ES_AppCreate.reserve_external pt lp.slot=1
T0 OS_TaskCreate call
T_EXT OS_TaskEntryPoint call arg.task_id=21
T0 OS_TaskCreate ret out.task_id=21 result=0
T0 CFE_ES_AppCreate.publish_external pt lp.slot=1 lp.pending_id=0x110001
T0 CFE_ES_AppCreate ret result=0
T_EXT CFE_ES_RunLoop call arg.RunStatus=1
T_EXT CFE_ES_RunLoop.raise_running pt
T_EXT CFE_ES_RunLoop ret result=1

T0 CFE_ES_RunAppTableScan call arg.ElapsedTime=500
T0 CFE_ES_RunAppTableScan.wait_external pt lp.slot=1
T0 CFE_ES_RunAppTableScan.wait_external pt lp.slot=2
T0 CFE_ES_RunAppTableScan ret result=1

T_EXT CFE_ES_ExitApp call arg.ExitStatus=0
T_EXT CFE_ES_ExitApp.stop_external pt
T_EXT CFE_ES_ExitApp ret
T_CORE CFE_ES_ExitApp call arg.ExitStatus=0
T_CORE CFE_ES_ExitApp.stop_external pt
T_CORE CFE_ES_ExitApp ret

T0 CFE_ES_CleanUpApp call arg.AppId=0x110001
T0 CFE_ES_CleanUpApp.retire pt lp.slot=1
T0 CFE_ES_CleanUpApp.retire pt lp.slot=2
T0 CFE_ES_CleanUpApp.free_record pt lp.slot=1
T0 CFE_ES_CleanUpApp.free_record pt lp.slot=2
T0 CFE_ES_CleanUpApp ret result=0

T0 CFE_ES_AppCreate call
T0 app_create_clear pt lp.slot=3
T0 CFE_ES_AppCreate.type_external pt lp.slot=3
T0 CFE_ES_AppCreate.reserve_external pt lp.slot=3
T0 CFE_ES_AppCreate.free_external pt lp.slot=3
T0 CFE_ES_AppCreate ret result=-1
T_EXT2 CFE_ES_ExitApp call arg.ExitStatus=0
T_EXT2 CFE_ES_ExitApp.stop_external pt
T_EXT2 CFE_ES_ExitApp ret
