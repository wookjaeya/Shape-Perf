cite m_es_runloop_false file "cfe/modules/es/fsw/src/cfe_es_api.c" lines 490 497 sha256 "7f549f021c4d33629150ef2019552d7cfec29a12108e41f7ce757e8a2d1f3d3a" note "CFE_ES_RunLoop: a run status other than APP_RUN returns false at once"

resource s0 kind osal.countsem key CF_CHANNEL_0_SEM_NAME
resource s1 kind osal.countsem key CF_CHANNEL_1_SEM_NAME
resource shutdown kind psp.shutdown

actor core-tx start record "core-tx" prov osal_bsp_main, psp_app_run_fn
actor CFE_ES input record "CFE_ES" prov psp_restart_req
actor CF record "CF" prov bp_startup_script, cf_app_init_status
actor BP record "BP" prov bp_startup_script, bp_flowinit_calls_throttle

program core-tx
  clear OS_ObjectIdInit.clear_table osal.countsem ABSENT prov osal_objectid_init, osal_api_init_call
  clear OS_CountSemAPI_Init.clear_names osal.countsem ABSENT prov osal_countsem_api_init, osal_api_init_countsem
  spawn OS_TaskCreate CFE_ES prov m_es_core_then_script, osal_task_create_def
  spawn OS_TaskCreate CF prov m_es_core_then_script, m_es_script_line, bp_startup_script, osal_task_create_def
  spawn OS_TaskCreate BP prov m_es_script_line, bp_startup_script, osal_task_create_def
  await shutdown SHUTDOWN_REQ prov psp_teardown
  set OS_Application_Run.teardown shutdown TEARDOWN prov psp_teardown, psp_app_run_fn
  delete-each OS_CountSemDelete osal.countsem effect retire status OS_SUCCESS prov osal_delete_all, osal_cleanup_object, osal_countsem_delete_def, osal_finalize_delete
  finish
end

# The restart command reaches ES at a time the record does not bound against CF and BP (an input of the run).
program CFE_ES
  mark "the restart command (an input of the run)"
  set CFE_PSP_Restart.request_shutdown shutdown SHUTDOWN_REQ prov psp_restart_req, psp_restart_fn
  finish
end

# initialize_throttling (bp_flow.c L121-L144), called first by BP_FlowInit: for each of the two names, the existence
# probe; on OS_SUCCESS "Found", else the creation; on OS_SUCCESS "Created", else "Failed"; then the next name.
program BP
  event BP_FlowInit call prov bp_flowinit_calls_throttle
  use OS_CountSemGetIdByName s0 role-site bp_existence_probe_call prov bp_flow_lookup_call, bp_flow_throttle_init, m_bp_num_throttles
    hit osal.countsem_lookup.entry before caller bp.so name sem_name
  if-result OS_SUCCESS found0 prov bp_flow_throttle_init
  create OS_CountSemCreate s0 effect publish role-site bp_create_call taken OS_ERR_NAME_TAKEN prov bp_flow_create_call, bp_flow_throttle_init, osal_allocate_new, osal_countsem_finalize, osal_finalize_new
    hit osal.countsem_create.entry before caller bp.so name sem_name
    hit bp_create_call after
  if-result OS_SUCCESS created0 prov bp_flow_throttle_init
  mark "event 14 Failed to create semaphore"
  goto next0 prov bp_flow_throttle_init
  label created0
  mark "event 15 Created semaphore"
  goto next0 prov bp_flow_throttle_init
  label found0
  mark "event 15 Found semaphore"
  label next0
  use OS_CountSemGetIdByName s1 role-site bp_existence_probe_call prov bp_flow_lookup_call, bp_flow_throttle_init, m_bp_num_throttles
    hit osal.countsem_lookup.entry before caller bp.so name sem_name
  if-result OS_SUCCESS found1 prov bp_flow_throttle_init
  create OS_CountSemCreate s1 effect publish role-site bp_create_call taken OS_ERR_NAME_TAKEN prov bp_flow_create_call, bp_flow_throttle_init, osal_allocate_new, osal_countsem_finalize, osal_finalize_new
    hit osal.countsem_create.entry before caller bp.so name sem_name
    hit bp_create_call after
  if-result OS_SUCCESS created1 prov bp_flow_throttle_init
  mark "event 14 Failed to create semaphore"
  goto next1 prov bp_flow_throttle_init
  label created1
  mark "event 15 Created semaphore"
  goto next1 prov bp_flow_throttle_init
  label found1
  mark "event 15 Found semaphore"
  label next1
  event BP_FlowInit ret prov bp_flowinit_calls_throttle
  mark "BP_FlowInit returns; on its success BP_CLA_Init creates BP_CLA_OUT (assumed: success, as in every record)"
  finish prov m_bp_flow_then_cla, m_bp_cla_out_child
    hit es.child_task.entry before caller bp.so
end
