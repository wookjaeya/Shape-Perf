# kid_illegal -- an event request whose identity was read before it was published.
#
# Unit-test values only.  The task reads the identity cell while it still holds the value the
# clearing of the global object left (0), passes it, and the event service rejects it with the
# documented code.  Afterwards the task publishes its identity, which is too late for that call.
#   - the value conjunct is false at its capture: the occurrence is decided at the call;
#   - the caller-level Allowed is none (the appreq is specified): VIOLATING;
#   - the registry conjunct is never reached: the decision stands (it does not become NOT_EVALUATED);
#   - the returned code agrees with the not_ready outcome of the value conjunct.
const CFE_PLATFORM_ES_MAX_APPLICATIONS 4
owner T_SB 2

T0 CFE_ES_Main call
T0 CFE_ES_Main.reset_records pt
T0 CFE_ES_Main.reset_states pt
T0 CFE_ES_CreateObjects call
T0 CFE_SB_EarlyInit call
T0 CFE_SB_EarlyInit.clear_global pt
T0 CFE_SB_EarlyInit ret
T0 core_phase2_begin pt
T0 CFE_ES_CreateObjects.reserve_core pt lp.slot=2
T0 CFE_ES_CreateObjects.type_core pt lp.slot=2
T0 OS_TaskCreate call
T_SB OS_TaskEntryPoint call arg.task_id=12
T0 OS_TaskCreate ret out.task_id=12 result=0
T0 CFE_ES_CreateObjects.publish_core pt lp.slot=2 lp.pending_id=0x110002
T_SB CFE_EVS_Register call
T_SB CFE_EVS_Register.clear_slot pt
T_SB CFE_EVS_Register.register pt
T_SB CFE_EVS_Register ret result=0
T_SB CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0 cell=@CFE_SB_Global.AppId value=0
T_SB CFE_EVS_SendEventWithAppID call arg.AppID=0
T_SB CFE_EVS_SendEventWithAppID ret result=0xc2000003
T_SB CFE_ES_GetAppID call
T_SB CFE_ES_GetAppID.self_live pt
T_SB CFE_ES_GetAppID.store_ok pt out.AppIdPtr=@CFE_SB_Global.AppId value=0x110002
T_SB CFE_ES_GetAppID ret result=0
