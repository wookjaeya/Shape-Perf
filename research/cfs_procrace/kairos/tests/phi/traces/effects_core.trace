# effects_core -- effects of the V1 profile that the other traces do not reach: the raise by
# CFE_ES_WaitForSystemState, the clearing of a core record at the shared point, the failure branch
# of the identity store, the documented BAD_ARGUMENT result, the teardown and the end of the process.
#
# Unit-test values only: nothing here is a recorded run and no value is a research condition.
# The sequences are synthetic and need not be ones a real run produces (slot 3 is cleared after its
# task ran, which a real start never does: the trace shows what the clearing effects do to a record
# that has a state and a tag).
#
#   slot 1  reserved, typed, published; WaitForSystemState raises its AppState to LATE_INIT, a lower
#           request leaves it, a higher one makes it RUNNING (a raise never lowers)
#   slot 2  reserved and typed, then cleared at the shared point: FREE, the undefined id, AppState
#           UNDEFINED, Type UNSET
#   slot 3  published and RUNNING, then cleared at the same point: the state and the tag are reset
#   T_N     a task whose record is not live: GetAppID stores the undefined id, a request that carries
#           it is rejected (the mechanism of case R2 on another path), and a call with a NULL pointer
#           returns the documented BAD_ARGUMENT
#   end     a restart request, then the teardown, then the return of main
const CFE_PLATFORM_ES_MAX_APPLICATIONS 4
owner T_A 1
owner T_C 3

T0 CFE_ES_CreateObjects.reserve_core pt lp.slot=1
T0 CFE_ES_CreateObjects.type_core pt lp.slot=1
T0 CFE_ES_CreateObjects.publish_core pt lp.slot=1 lp.pending_id=0x110001
T_A CFE_ES_WaitForSystemState call arg.MinSystemState=2 arg.TimeOutMilliseconds=1000
T_A CFE_ES_WaitForSystemState.raise_state pt lp.required=2
T_A CFE_ES_WaitForSystemState.raise_state pt lp.required=1
T_A CFE_ES_WaitForSystemState.raise_state pt lp.required=3
T_A CFE_ES_WaitForSystemState ret result=0

T0 CFE_ES_CreateObjects.reserve_core pt lp.slot=2
T0 CFE_ES_CreateObjects.type_core pt lp.slot=2
T0 core_clear pt lp.slot=2

T0 CFE_ES_CreateObjects.reserve_core pt lp.slot=3
T0 CFE_ES_CreateObjects.type_core pt lp.slot=3
T0 CFE_ES_CreateObjects.publish_core pt lp.slot=3 lp.pending_id=0x110003
T_C CFE_ES_RunLoop call arg.RunStatus=1
T_C CFE_ES_RunLoop.raise_running pt
T_C CFE_ES_RunLoop ret result=1
T0 core_clear pt lp.slot=3

T_N CFE_ES_GetAppID call
T_N CFE_ES_GetAppID.self_live pt
T_N CFE_ES_GetAppID.store_fail pt out.AppIdPtr=@CFE_SB_Global.AppId value=0
T_N CFE_ES_GetAppID ret result=0xc4000001
T_N CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0 cell=@CFE_SB_Global.AppId value=0
T_N CFE_EVS_SendEventWithAppID call arg.AppID=0
T_N CFE_EVS_SendEventWithAppID ret result=0xc2000003
T_N CFE_ES_GetAppID call
T_N CFE_ES_GetAppID ret result=0xc400000a

T_A CFE_PSP_Restart call arg.resetType=1
T_A CFE_PSP_Restart.request_shutdown pt
M OS_Application_Run call
M OS_Application_Run.teardown pt
M OS_Application_Run ret
M main.terminal pt
