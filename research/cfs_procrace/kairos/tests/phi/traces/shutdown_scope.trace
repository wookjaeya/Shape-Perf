# shutdown_scope -- the scope of an occurrence, and the end of the process.
#
# Unit-test values only.  The default scope ends at the shutdown request:
#   1  decided before the request (the capture is false at the call): scope default;
#   2  begun before the request, decided by the registry point after it: scope teardown;
#   3  begun and decided after the request: scope teardown.
# The process-terminal step ends the replay: the events that follow it are not replayed.
const CFE_PLATFORM_ES_MAX_APPLICATIONS 4
owner T_SB 2

T0 CFE_ES_CreateObjects.reserve_core pt lp.slot=2
T0 CFE_ES_CreateObjects.publish_core pt lp.slot=2 lp.pending_id=0x110002

T_SB CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0
T_SB CFE_EVS_SendEventWithAppID call arg.AppID=0
T_SB CFE_EVS_SendEventWithAppID ret result=0xc2000003

T_SB CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0x110002
T_SB CFE_EVS_SendEventWithAppID call arg.AppID=0x110002
T0 CFE_PSP_Restart call arg.resetType=1
T0 CFE_PSP_Restart.request_shutdown pt
T_SB CFE_EVS_SendEventWithAppID.slot_registered pt
T_SB CFE_EVS_SendEventWithAppID ret result=0xc2000002

T_SB CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0
T_SB CFE_EVS_SendEventWithAppID call arg.AppID=0
T_SB CFE_EVS_SendEventWithAppID ret result=0xc2000003

T0 abort call
T0 CFE_PSP_Restart ret
T_SB CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0
