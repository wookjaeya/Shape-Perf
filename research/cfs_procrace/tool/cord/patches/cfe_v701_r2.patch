@@ -47,4 +47,24 @@
 #include "cfe_sbr.h"
 #include "cfe_core_resourceid_basevalues.h"
 
+/*
+ * CORD instrumentation (research copy, case R2 / cFE #2663; tool/cord/patches/cfe_v701_r2.patch).
+ * Every SB call site that passes SB's own AppId to CFE_EVS_SendEventWithAppID reads it through
+ * CFE_SB_CORD_APPID(). With CORD_ENABLE it records USE("sb.appid") and USE("sb.evsreg") at the call
+ * site (a = the AppId value read) and returns the value; without CORD_ENABLE it is CFE_SB_Global.AppId.
+ */
+#include "cord.h"
+#ifdef CORD_ENABLE
+static inline CFE_ES_AppId_t CFE_SB_CordAppIdUse(const char *File, int Line, const char *Func)
+{
+    CFE_ES_AppId_t AppId = CFE_SB_Global.AppId;
+    cord_event(CORD_K_USE, "sb.appid", (long)CFE_RESOURCEID_TO_ULONG(AppId), 0, File, Line, Func);
+    cord_event(CORD_K_USE, "sb.evsreg", (long)CFE_RESOURCEID_TO_ULONG(AppId), 0, File, Line, Func);
+    return AppId;
+}
+#define CFE_SB_CORD_APPID() CFE_SB_CordAppIdUse(__FILE__, __LINE__, __func__)
+#else
+#define CFE_SB_CORD_APPID() (CFE_SB_Global.AppId)
+#endif
+
 #endif /* CFE_SB_MODULE_ALL_H */
