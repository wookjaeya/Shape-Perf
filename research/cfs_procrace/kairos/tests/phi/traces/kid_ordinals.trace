# kid_ordinals -- several occurrences of one use: NOT_EVALUATED, READY, a second actor, a call
# with no capture, a capture with no call.
#
# Unit-test values only.
#   1  T_SB, key 0x110002: the call returns the invalid-parameter code before it reaches the registry
#      point; nothing is false and a point was not passed: NOT_EVALUATED (neither ready nor not
#      ready).  The outcome is an error outcome: no statement about readiness, not checked.
#   2  T_SB, same key: the k-th occurrence with this key by this actor is 2; the call is READY.
#   3  T_TIME, same key: another actor starts again at ordinal 1.
#   4  T_SB, a call with no capture before it reads its value at the call (source: call): READY;
#      a capture that no call follows (the last line) begins nothing.
const CFE_PLATFORM_ES_MAX_APPLICATIONS 4
owner T_SB 2
owner T_TIME 3

T0 CFE_ES_CreateObjects.reserve_core pt lp.slot=2
T0 CFE_ES_CreateObjects.publish_core pt lp.slot=2 lp.pending_id=0x110002
T_SB CFE_EVS_Register call
T_SB CFE_EVS_Register.clear_slot pt
T_SB CFE_EVS_Register.register pt
T_SB CFE_EVS_Register ret result=0

T_SB CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0x110002
T_SB CFE_EVS_SendEventWithAppID call arg.AppID=0x110002
T_SB CFE_EVS_SendEventWithAppID ret result=0xc2000008

T_SB CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0x110002
T_SB CFE_EVS_SendEventWithAppID call arg.AppID=0x110002
T_SB CFE_EVS_SendEventWithAppID.slot_registered pt
T_SB CFE_EVS_SendEventWithAppID ret result=0

T_TIME CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0x110002
T_TIME CFE_EVS_SendEventWithAppID call arg.AppID=0x110002
T_TIME CFE_EVS_SendEventWithAppID.slot_registered pt
T_TIME CFE_EVS_SendEventWithAppID ret result=0

T_SB CFE_EVS_SendEventWithAppID call arg.AppID=0x110002
T_SB CFE_EVS_SendEventWithAppID.slot_registered pt
T_SB CFE_EVS_SendEventWithAppID ret result=0

T_SB CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0
