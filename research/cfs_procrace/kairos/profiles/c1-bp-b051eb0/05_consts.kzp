# 05_consts.kzp -- constants of profile c1-bp-b051eb0.  A literal is read from the cited line; a `ref eval`
# constant is resolved in the named translation unit (its value depends on the build's configuration).
phi 1;

# OSAL status codes (osapi-error.h, the same lines in both bundle candidates).
const OS_SUCCESS = 0 prov osal_err_success;
const OS_ERROR = -1 prov osal_err_error;
const OS_INVALID_POINTER = -2 prov osal_err_invalid_pointer;
const OS_SEM_FAILURE = -6 prov osal_err_sem_failure;
const OS_ERR_NAME_TOO_LONG = -13 prov osal_err_name_too_long;
const OS_ERR_NO_FREE_IDS = -14 prov osal_err_no_free_ids;
const OS_ERR_NAME_TAKEN = -15 prov osal_err_name_taken;
const OS_ERR_NAME_NOT_FOUND = -17 prov osal_err_name_not_found;
const OS_INVALID_SEM_VALUE = -20 prov osal_err_invalid_sem_value;

# The semaphore names as built: the CF table of the public BP build and BP's defaults agree
# (plan/C1_build_manifest.md 6: the installed .tbl bytes, bp.so strings).
const CF_CHANNEL_0_SEM_NAME = "BP0_tsem" prov bp_semcfg_names, bp_cfg_tx_ch0_name, bp_cfg_rx_ch0_name;
const CF_CHANNEL_1_SEM_NAME = "BP1_tsem" prov bp_semcfg_names, bp_cfg_tx_ch1_name, bp_cfg_rx_ch1_name;

const CFE_ES_RunStatus_APP_ERROR = 3 prov es_runstatus_app_error;

# The identifier space of ES application ids (the owner kind): SIMPLE resource-id mode, as the build's
# OMIT_DEPRECATED is empty (plan/C1_build_manifest.md 2; the build's CMakeCache).
const CFE_RESOURCEID_UNDEFINED = 0 prov resid_undefined_def;
const CFE_RESOURCEID_RESERVED = 0xffffffff prov resid_reserved_def;
const CFE_RESOURCEID_MAX = 0xffff prov resid_max_def, osal_index_mask_shift;
const CFE_ES_APPID_BASE = 0x110000 prov resid_appid_offset, resid_appid_base, resid_make_base, resid_mark_simple, resid_mode_cmake, osal_type_user, osal_index_mask_shift note "SIMPLE resource-ID mode; a STRICT build has 0x02110000";
const CFE_PLATFORM_ES_MAX_APPLICATIONS = ref eval "CFE_PLATFORM_ES_MAX_APPLICATIONS" in "cfe/modules/es/fsw/src/cfe_es_start.c" prov es_start_table_loop;
