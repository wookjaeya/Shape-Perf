window._customJS = function (_root) {
  var root = _root || document;
  var bar = root.querySelector('[data-region]');
  if (!bar) return;

  var panel = () =>  root.querySelector('#prtgBarPanel');
  var toggle = bar.querySelector('.pbar-toggle');
  var spacer = root.querySelector('#prtgBarSpacer');

  /* ---- 1. expand / collapse the panel ---- */
  function setOpen(open) {
    if (panel()){
        panel().classList.toggle('is-open', open);
        }else if (open) {
         observeDynamicElement('.suggestions', root, (dynamicDiv) => panel().classList.toggle('is-open', open));
       }
    toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
  }
  toggle.addEventListener('mousedown', function () {
    var currentState = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!currentState);
  });
  root.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' || e.key === 'Esc') setOpen(false);
  });





  /* ---- 3. compact bar once it scrolls off the top ---- */
  var top = 0, height = 0, sticky = false;

  function measure() {
    if (sticky) return;
    var rect = bar.getBoundingClientRect();
    top = rect.top + (window.pageYOffset || document.documentElement.scrollTop);
    height = bar.offsetHeight;
  }

  function onScroll() {
    var y = window.pageYOffset || document.documentElement.scrollTop;
    var should = y > top + height;
    if (should === sticky) return;
    sticky = should;
    bar.classList.toggle('is-sticky', sticky);
    spacer.style.display = sticky ? 'block' : 'none';
    spacer.style.height  = sticky ? height + 'px' : '0px';
    if (sticky) setOpen(false);
  }
  function observeDynamicElement(selector, root, callback) {
      // 1. Check if the element already exists in the DOM right now
      const existingElement = root.querySelector(selector);
      if (existingElement) {
        callback(existingElement);
        return; // Element found, no need to start the observer
      }

      // 2. Setup the observer to watch for new additions
      const observer = new MutationObserver((mutationsList, obs) => {
        // Look through all changes happening in the DOM
        for (const mutation of mutationsList) {
          // Check if new nodes/elements were added
          if (mutation.type === 'childList') {
            const foundElement = root.querySelector(selector);
            if (foundElement) {
              obs.disconnect(); // Stop watching immediately to save memory
              callback(foundElement); // Execute your code with the new element
              break;
            }
          }
        }
      });

      // 3. Start observing the entire document tree for structural changes
      observer.observe(root.body, {
        childList: true,
        subtree: true
      });
    }

  measure();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', function () { measure(); onScroll(); });
};

(function() {
    window._customJS(null);
})();
}catch(e){ console.log("err", e)};
