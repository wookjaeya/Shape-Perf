# ---- core-tx: the semaphore API (the lookup and the creation, every caller) ---------------------
# The name is the string at the second argument, read by the kernel when the probe fires (the slot role is
# the parameter name, so the replay takes it as the key text); the pointers stay as numbers.
site osal.countsem_lookup.entry entry func=OS_CountSemGetIdByName prov=osal_countsem_lookup_def s0=rdi:u64:sem_id_ptr s1=+0(rsi):string:sem_name s2=rsi:u64:sem_name_ptr s3=stack+0:u64:return_address
site osal.countsem_lookup.ret   ret   func=OS_CountSemGetIdByName prov=osal_countsem_lookup_doc s0=rax:u32:status s3=ip:u64:return_address
site osal.countsem_create.entry entry func=OS_CountSemCreate prov=osal_countsem_create_def s0=rdi:u64:sem_id_ptr s1=+0(rsi):string:sem_name s2=rdx:u32:sem_initial_value s3=stack+0:u64:return_address
site osal.countsem_create.ret   ret   func=OS_CountSemCreate prov=osal_countsem_create_def s0=rax:u32:status s3=ip:u64:return_address
# The linearization point of the lookup's precondition (the Phi point OS_CountSemGetIdByName.exists, the call
# of OS_ObjectIdFindByName): in these builds the lookup reaches it by a tail jump (`jmp`, kz anchor checks it
# is the only transfer), so the point is the search's entry reached from the lookup, attributed by the stack
# pointer of the open lookup call.  The name the search reads is its second argument.
site OS_CountSemGetIdByName.exists point func=OS_CountSemGetIdByName enter=OS_ObjectIdFindByName prov=osal_find_by_name_def s1=+0(rsi):string:sem_name s3=stack+0:u64:return_address
# The id the lookup stores through its out-parameter: inside the search, after `*object_id = token.obj_id`,
# the release of the token is OS_ObjectIdTransactionFinish(&token, NULL) (inlined OS_ObjectIdRelease; one
# call in the search's code); the token's obj_id is at byte offset 16.  The slot role names the out
# parameter, so the replay sets out.sem_id on the lookup's return.
site osal.countsem_lookup.found point func=OS_CountSemGetIdByName enter=OS_ObjectIdFindByName>OS_ObjectIdTransactionFinish prov=osal_token_layout s0=+16(rdi):u32:sem_id s3=stack+0:u64:return_address
# The creation's effect point (the Phi point OS_CountSemCreate.publish, the call of OS_ObjectIdFinalizeNew,
# osapi-countsem.c L106), with the status it finalizes (first argument), and the id it publishes: the only
# OS_NotifyEvent call of OS_ObjectIdFinalizeNew is made on success with token->obj_id, the value stored to the
# out-parameter (second argument).
site OS_CountSemCreate.publish point func=OS_CountSemCreate enter=OS_ObjectIdFinalizeNew prov=osal_countsem_create_def s0=rdi:u32:operation_status s3=stack+0:u64:return_address
site osal.countsem_create.created point func=OS_CountSemCreate enter=OS_ObjectIdFinalizeNew>OS_NotifyEvent prov=osal_finalize_new_def s0=rdi:u32:event s1=rsi:u32:sem_id s3=stack+0:u64:return_address
# The exit of an application task (CF on its init failure, BP on a provider init failure): the status.
site es.exit_app.entry entry func=CFE_ES_ExitApp prov=es_exitapp_sig s0=rdi:u32:exit_status s3=stack+0:u64:return_address

# ---- cf.so: the dependent lookup in its caller ---------------------------------------------------------
site cf.init.entry entry func=CF_Init bin=cf.so prov=cf_app_init_status s3=stack+0:u64:return_address
site cf.init.ret   ret   func=CF_Init bin=cf.so prov=cf_app_init_status s0=rax:u32:status s3=ip:u64:return_address
site cf.init_engine.entry entry func=CF_CFDP_InitEngine bin=cf.so prov=cf_app_init_engine_call s3=stack+0:u64:return_address
site cf.init_engine.ret   ret   func=CF_CFDP_InitEngine bin=cf.so prov=cf_app_init_engine_call s0=rax:u32:status s3=ip:u64:return_address
# The role site of cf-dependent-lookup (the Phi site cf_lookup_call): right after the lookup returns in
# CF_CFDP_InitEngine, with the status CF sees.  The build has no line table: the call is found in the
# function (one call of OS_CountSemGetIdByName through its PLT stub).
site cf_lookup_call point func=CF_CFDP_InitEngine after-call=OS_CountSemGetIdByName bin=cf.so prov=cf_cfdp_lookup_call s0=rax:u32:status
# The delay of the retry loop (833fdbb only; the Phi site cf_retry_delay).
site cf_retry_delay point func=CF_CFDP_InitEngine after-call=OS_TaskDelay bin=cf.so prov=cf_cfdp_retry_loop s0=rax:u32:status

# ---- bp.so: the provider ---------------------------------------------------------------------------
site bp.flow_init.entry entry func=BP_FlowInit bin=bp.so prov=bp_flowinit_calls_throttle s3=stack+0:u64:return_address
site bp.flow_init.ret   ret   func=BP_FlowInit bin=bp.so prov=bp_flowinit_calls_throttle s0=rax:u32:status s3=ip:u64:return_address
# The role site of bp-existence-probe (Phi site bp_existence_probe_call) and the create call site (Phi
# site bp_create_call).  initialize_throttling is static and called only from BP_FlowInit (bp_flow.c L121,
# L524); the release build has no symbol for it (nm): its calls are in the code of BP_FlowInit, one call of
# each callee (checked by kz anchor).
site bp_existence_probe_call point func=BP_FlowInit after-call=OS_CountSemGetIdByName bin=bp.so prov=bp_flow_throttle_init s0=rax:u32:status
site bp_create_call point func=BP_FlowInit after-call=OS_CountSemCreate bin=bp.so prov=bp_flow_throttle_init s0=rax:u32:status

# ---- core-tx: creation-side evidence of app_owner (as cfs-v7.0.1 sites 21-25, re-anchored) -------------
site es.start_task.entry entry func=CFE_ES_StartAppTask decoder=owner-request prov=es_startapptask_def s0=rsi:u64:name_ptr s1=rdx:u64:entry_fn s2=r8:u32:owner_id s3=stack+0:u64:return_address
site es.start_task.ret   ret   func=CFE_ES_StartAppTask decoder=request-return prov=es_startapptask_def s0=rax:u32:status s3=ip:u64:return_address
site es.child_task.entry entry func=CFE_ES_CreateChildTask decoder=child-request prov=es_childtask_owner s0=rsi:u64:name_ptr s1=rdx:u64:entry_fn s3=stack+0:u64:return_address
site es.child_task.ret   ret   func=CFE_ES_CreateChildTask decoder=request-return prov=es_childtask_sig s0=rax:u32:status s3=ip:u64:return_address
site osal.task_create.entry entry func=OS_TaskCreate decoder=spawn-create prov=osal_task_create_def s0=rsi:u64:name_ptr s1=rdx:u64:entry_fn s2=r9:u32:priority s3=stack+0:u64:return_address
site osal.task_create.ret   ret   func=OS_TaskCreate decoder=spawn-return prov=osal_task_create_def s0=rax:u32:status s3=ip:u64:return_address
site osal.task_entry entry func=OS_TaskEntryPoint decoder=thread-entry prov=osal_task_entry_def s0=rdi:u32:task_id s3=stack+0:u64:return_address
# The id OS_TaskCreate assigns, where it is passed to the new thread: in these OSAL revisions entry_arg is
# the 5th argument (r8), not the 6th as in cfs-v7.0.1; OS_TaskCreate_Impl reaches the function by a tail
# jump, on the creating thread, inside the OS_TaskCreate call.
site osal.task_create.id entry func=OS_Posix_InternalTaskCreate_Impl decoder=spawn-id prov=osal_taskcreate_impl_arg s0=r8:u32:task_id s1=rcx:u64:entry_fn s3=stack+0:u64:return_address
