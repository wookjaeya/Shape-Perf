   83  int32 OS_CountSemCreate(osal_id_t *sem_id, const char *sem_name, uint32 sem_initial_value, uint32 options)
   84  {
   85      int32                           return_code;
   86      OS_object_token_t               token;
   87      OS_count_sem_internal_record_t *countsem;
   88  
   89      /* Check parameters */
   90      OS_CHECK_POINTER(sem_id);
   91      OS_CHECK_APINAME(sem_name);
   92  
   93      /* Note - the common ObjectIdAllocate routine will lock the object type and leave it locked. */
   94      return_code = OS_ObjectIdAllocateNew(LOCAL_OBJID_TYPE, sem_name, &token);
   95      if (return_code == OS_SUCCESS)
   96      {
   97          countsem = OS_OBJECT_TABLE_GET(OS_count_sem_table, token);
   98  
   99          /* Reset the table entry and save the name */
  100          OS_OBJECT_INIT(token, countsem, obj_name, sem_name);
  101  
  102          /* Now call the OS-specific implementation.  This reads info from the table. */
  103          return_code = OS_CountSemCreate_Impl(&token, sem_initial_value, options);
  104  
  105          /* Check result, finalize record, and unlock global table. */
  106          return_code = OS_ObjectIdFinalizeNew(return_code, &token, sem_id);
  107      }
  108  
  109      return return_code;
  110  }
