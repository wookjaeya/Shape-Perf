+/*
+ * CORD instrumentation (research copy, case R2 / cFE #2663; tool/cord/patches/cfe_v701_r2.patch).
+ * CFE_ES_CORD_APPSTATE records a SETSTATE or WAITRET event on key "es.appstate:<AppName>" of the
+ * given app record (a, b as in cord.h). Without CORD_ENABLE it expands to nothing.
+ */
+#include "cord.h"
+#ifdef CORD_ENABLE
+#include <stdio.h>
+#define CFE_ES_CORD_APPSTATE(Kind, AppRecPtr, A, B)                                                 \
+    do                                                                                             \
+    {                                                                                              \
+        char CordKey_[64];                                                                         \
+        snprintf(CordKey_, sizeof(CordKey_), "es.appstate:%s", (AppRecPtr)->AppName);              \
+        cord_event((Kind), CordKey_, (long)(A), (long)(B), __FILE__, __LINE__, __func__);          \
+    } while (0)
+#else
+#define CFE_ES_CORD_APPSTATE(Kind, AppRecPtr, A, B) ((void)0)
+#endif
+
 #endif /* CFE_ES_MODULE_ALL_H */
