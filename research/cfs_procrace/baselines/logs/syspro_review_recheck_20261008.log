# variant: additionally split camelCase segments (/tmp/claude-0/-home-user-Shape-Perf/e983f27d-f015-5a5d-b912-399245630e78/scratchpad/fixcheck/camel.py)
import re,sys
names=set()
for l in open('/usr/include/x86_64-linux-gnu/asm/unistd_64.h'):
    m=re.match(r"#define __NR_(\w+)\s+\d+",l)
    if m: names.add(m.group(1))
for p in sys.argv[1:]:
    t="".join(l for l in open(p) if not l.startswith(("# Source:","# Retrieved","# created_at")))
    words=re.findall(r"[A-Za-z][A-Za-z0-9_]*",t)
    parts=set()
    for w in words:
        for seg in w.split('_'):
            parts.update(x.lower() for x in re.findall(r"[A-Z]+(?=[A-Z][a-z])|[A-Z]?[a-z]+|[A-Z]+|\d+",seg))
    print(p.split('/')[-1], sorted(parts & names))
