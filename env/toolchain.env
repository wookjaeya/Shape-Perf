# Pinned toolchain versions (spec §5.4). Sourced by env/build_toolchain.sh and
# env/Dockerfile. Change these only together with a new G0 run.

# ONNX-MLIR release tag v0.5.1.1 (commit date 2026-08-27).
ONNX_MLIR_REPO=https://github.com/onnx/onnx-mlir.git
ONNX_MLIR_TAG=v0.5.1.1
ONNX_MLIR_SHA=1e017c9fcd7ae7218731ae799f13a957e0cbc80b

# LLVM commit required by utils/clone-mlir.sh *at ONNX_MLIR_SHA*.
LLVM_REPO=https://github.com/llvm/llvm-project.git
LLVM_SHA=1053047a4be7d1fece3adaf5e7597f838058c947

# protobuf C++ version used by docker/Dockerfile.llvm-project at ONNX_MLIR_SHA
# (ARG PROTOBUF_VERSION=33.5). Python protobuf comes from PyPI (6.33.5).
PROTOBUF_REPO=https://github.com/protocolbuffers/protobuf.git
PROTOBUF_TAG=v33.5
