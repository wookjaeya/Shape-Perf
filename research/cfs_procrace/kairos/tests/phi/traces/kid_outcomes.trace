# kid_outcomes -- the outcome codes of CFE_EVS_SendEventWithAppID against the readiness the replay
# computes (O4(a)), and the decision when two preconditions are false at different events.
#
# Unit-test values only: nothing here is a recorded run and no value is a research condition.
#
#   1  both preconditions hold and the event was squelched: the code is of class ready, it agrees
#   2  the AppId is invalid (false at the capture) and its slot is not registered (false at the
#      point, later): the earliest false conjunct decides, so the occurrence is decided at the call
#   3  a valid but unregistered AppId, and the call returns success: the outcome disagrees
#   4  a valid, registered AppId, and the call returns NOT_REGISTERED: the outcome disagrees
#   5  a NULL format: the code is an error and says nothing about readiness
const CFE_PLATFORM_ES_MAX_APPLICATIONS 4
owner T_SB 2

T0 CFE_ES_CreateObjects.reserve_core pt lp.slot=2
T0 CFE_ES_CreateObjects.publish_core pt lp.slot=2 lp.pending_id=0x110002
T_SB CFE_EVS_Register call
T_SB CFE_EVS_Register.clear_slot pt
T_SB CFE_EVS_Register.register pt
T_SB CFE_EVS_Register ret result=0

T_SB CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0x110002
T_SB CFE_EVS_SendEventWithAppID call arg.AppID=0x110002
T_SB CFE_EVS_SendEventWithAppID.slot_registered pt
T_SB CFE_EVS_SendEventWithAppID ret result=0xc2000009

T_SB CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0x7777
T_SB CFE_EVS_SendEventWithAppID call arg.AppID=0x7777
T_SB CFE_EVS_SendEventWithAppID.slot_registered pt
T_SB CFE_EVS_SendEventWithAppID ret result=0xc2000003

T_SB CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0x110003
T_SB CFE_EVS_SendEventWithAppID call arg.AppID=0x110003
T_SB CFE_EVS_SendEventWithAppID.slot_registered pt
T_SB CFE_EVS_SendEventWithAppID ret result=0

T_SB CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0x110002
T_SB CFE_EVS_SendEventWithAppID call arg.AppID=0x110002
T_SB CFE_EVS_SendEventWithAppID.slot_registered pt
T_SB CFE_EVS_SendEventWithAppID ret result=0xc2000002

T_SB CFE_EVS_SendEventWithAppID.id_valid pt arg.AppID=0x110002
T_SB CFE_EVS_SendEventWithAppID call arg.AppID=0x110002
T_SB CFE_EVS_SendEventWithAppID ret result=0xc2000008
