# 01_prov.kzp -- the cited texts of profile cfs-v7.0.1.
#
# Every record names a file of the pinned bundle (relative to its root), the cited lines and the
# SHA-256 of those lines (each followed by LF; `sed -n 'A,Bp' file | sha256sum` gives the same
# value).  `kz-phi verify-prov` and the ctest `profile_provenance` re-read the bundle and compare.
# The records here were read at the pins of 00_profile.kzp; nothing is quoted from memory.
#
# Tier and kind: contract-backed <- api_doc; code-derived <- code_pattern; researcher <- researcher.
# A record with a side (supplier, caller, rule) says what kind of statement the text is for the
# readiness specification that cites it (SPEC 1.6 "Side of a provenance record").
phi 1;

prov evs_h_appid_note {
  tier contract-backed;
  kind api_doc;
  side caller;
  file "cfe/modules/core_api/fsw/inc/cfe_evs.h";
  lines 168 172;
  sha256 "acb3967b445672203af748f7bc65f2f3a91187ef107a607b1645420e1570f1ed";
}

