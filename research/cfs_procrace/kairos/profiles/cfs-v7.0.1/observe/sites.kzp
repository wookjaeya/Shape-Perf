# The send function's call and return are sites 0 and 1; the registry check lies between them.
site evs.register.entry entry func=CFE_EVS_Register prov=evs_register_def s3=stack+0:u64:return_address
site evs.register.ret   ret   func=CFE_EVS_Register prov=evs_register_def s0=rax:u32:status s3=ip:u64:return_address
site CFE_EVS_Register.clear_slot point at=cfe_evs.c:56 after-call=memset prov=evs_reg_memset s0=rax:u64:slot_ptr
# The return site after EVS_AppDataSetUsed is the join of the function's return paths (kz anchor
# refuses it): the point is the start of the line, before the call.
site CFE_EVS_Register.register   point at=cfe_evs.c:106 line-start prov=evs_reg_publish
site CFE_EVS_SendEventWithAppID.slot_registered point at=cfe_evs.c:190 after-call=EVS_AppDataIsMatch prov=evs_send_ismatch s0=rax:u8:is_match
site es.wait.entry entry func=CFE_ES_WaitForSystemState prov=es_wait_def s0=rdi:u32:min_system_state s1=rsi:u32:timeout_milliseconds s3=stack+0:u64:return_address
site es.wait.ret   ret   func=CFE_ES_WaitForSystemState prov=es_wait_def s0=rax:u32:status s3=ip:u64:return_address
# Before the store of line 573 (the branch that raises is taken).  The raised level is a register at
# the store, not an argument: this backend does not read it.
site CFE_ES_WaitForSystemState.raise_state point at=cfe_es_api.c:573 line-start prov=es_wait_raise
# One memset, two effects of the phi profile (records and states): two sites at one address.
site CFE_ES_Main.reset_records point at=cfe_es_start.c:82 after-call=memset prov=es_main_memset s0=rax:u64:dest
site CFE_ES_Main.reset_states  point at=cfe_es_start.c:82 after-call=memset prov=es_main_memset s0=rax:u64:dest
site CFE_ES_CreateObjects.reserve_core point at=cfe_es_start.c:803 after-call=CFE_ES_AppRecordSetUsed prov=es_core_reserve
site CFE_ES_CreateObjects.publish_core point at=cfe_es_start.c:818 after-call=CFE_ES_AppRecordSetUsed prov=es_core_publish
site core_clear point at=cfe_es_start.c:823 line-start prov=es_core_clear

