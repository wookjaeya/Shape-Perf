source cfe root "cfe" rev "c5fb2b4d540bd55eb6c3707da7dd13eee679d4dd";
source cfs root "" rev "088b2fa828db9ff7e00733f1908e0eeb59f66ce3";
source osal root "osal" rev "d2d877a69cff47452bcca274b309147d48e6c16f";
source psp root "psp" rev "c4b3b0b65b119e106481ad8e20976ae4d7f554e3";
const CFE_ES_APPID_BASE = 0x110000 prov osal_index_mask_shift, osal_type_user, resid_appid_base, resid_appid_offset, resid_make_base, resid_mark_simple, resid_mode_cmake note "SIMPLE resource-ID mode; a STRICT build has 0x02110000. Basis-dependent: the basis record must agree.";
const CFE_ES_BAD_ARGUMENT = 0xc400000a prov err_h_bad_argument;
const CFE_ES_ERR_RESOURCEID_NOT_VALID = 0xc4000001 prov err_h_resourceid_not_valid;
const CFE_ES_OPERATION_TIMED_OUT = 0xc4000027 prov err_h_timed_out;
const CFE_EVS_APP_ILLEGAL_APP_ID = 0xc2000003 prov err_h_illegal_app_id, err_h_severity;
const CFE_EVS_APP_NOT_REGISTERED = 0xc2000002 prov err_h_not_registered;
const CFE_EVS_APP_SQUELCHED = 0xc2000009 prov err_h_squelched;
const CFE_EVS_INVALID_PARAMETER = 0xc2000008 prov err_h_invalid_parameter;
const CFE_EVS_UNKNOWN_FILTER = 0xc2000001 prov err_h_unknown_filter;
const CFE_PLATFORM_CORE_MAX_STARTUP_MSEC = ref eval "CFE_PLATFORM_CORE_MAX_STARTUP_MSEC" in "cfe/modules/es/fsw/src/cfe_es_start.c" prov es_start_sync_call;
const CFE_PLATFORM_ES_MAX_APPLICATIONS = ref eval "CFE_PLATFORM_ES_MAX_APPLICATIONS" in "cfe/modules/es/fsw/src/cfe_es_start.c" prov es_start_table_loop;
const CFE_RESOURCEID_MAX = 65535 prov osal_index_mask_shift, resid_max_def;
const CFE_RESOURCEID_RESERVED = 0xffffffff prov resid_reserved_def;
const CFE_RESOURCEID_UNDEFINED = 0 prov resid_undefined_def;
const CFE_SUCCESS = 0 prov err_h_success;
context {
  owner_kind es.app;
  prov es_ctx_lookup;
}
scope {
  kind es.shutdown;
  request SHUTDOWN_REQ;
  teardown TEARDOWN;
  prov psp_restart_req, psp_teardown;
}
kind cell(l: Loc) {
  states INVALID < VALID;
  initial INVALID;
  scope process;
  derived VALID when valid(value(l));
  prov r_cell_generic;
}
kind es.app(rec: Int) {
  states FREE < RESERVED < LIVE;
  initial FREE;
  scope process;
  table CFE_PLATFORM_ES_MAX_APPLICATIONS;
  ids {
    undefined CFE_RESOURCEID_UNDEFINED;
    reserved CFE_RESOURCEID_RESERVED;
    base CFE_ES_APPID_BASE;
    serial_max CFE_RESOURCEID_MAX;
  }
  tag Type { UNSET, CORE, EXTERNAL, LIBRARY };
  transition FREE -> RESERVED on reserve;
  transition LIVE -> RESERVED on retire;
  transition RESERVED -> FREE on clear;
  transition RESERVED -> FREE on free;
  transition RESERVED -> LIVE on publish;
  prov es_appid_toindex_fn, es_apprecord_struct, es_apps_cleanup_free, es_apps_cleanup_retire, es_apptype_enum, es_record_helpers, es_start_clear, es_start_publish, es_start_reserve, es_start_type_core, resid_toindex_fn;
}
kind es.appstate(rec: Res<es.app>) {
  states UNDEFINED < EARLY_INIT < LATE_INIT < RUNNING < WAITING < STOPPED;
  initial UNDEFINED;
  scope process;
  table CFE_PLATFORM_ES_MAX_APPLICATIONS;
  prov es_apprecord_struct, es_appstate_enum;
}
kind es.self(a: Actor) {
  states ABSENT < LIVE;
  initial ABSENT;
  scope process;
  derived LIVE when state(owner(a)) = LIVE;
  prov es_ctx_lookup, r_es_self_derived;
}
kind es.shutdown() {
  states RUN < SHUTDOWN_REQ < TEARDOWN;
  initial RUN;
  scope process;
  transition RUN -> SHUTDOWN_REQ on request;
  transition SHUTDOWN_REQ -> TEARDOWN on teardown;
  prov psp_idle_shutdownreq_field, psp_restart_req, psp_teardown;
}
kind evs.reg(app: Id<es.app>) {
  states UNREG < REG;
  initial UNREG;
  scope process;
  transition REG -> UNREG on clear;
  transition UNREG -> REG on register;
  prov evs_appdata_struct, evs_reg_memset, evs_reg_publish, evs_utils_ismatch, evs_utils_setused, r_evs_reg_key_by_id;
}
loc CFE_SB_Global.AppId {
  struct "CFE_SB_Global_t";
  field "AppId";
  holds Id<es.app>;
  prov sb_appinit_getappid, sb_global_appid_field, sb_global_def, sb_global_typedef;
}
bind field "CFE_ES_AppRecord_t" "AppId" as state(es.app(rec)) prov es_apprecord_struct, es_record_helpers;
bind field "CFE_ES_AppRecord_t" "AppState" as state(es.appstate(rec)) prov es_apprecord_struct, es_appstate_enum;
bind field "CFE_ES_AppRecord_t" "Type" as tag(es.app(rec), Type) prov es_apprecord_struct, es_apptype_enum;
bind field "CFE_PSP_IdleTaskState_t" "ShutdownReq" as state(es.shutdown()) prov psp_idle_shutdownreq_field, psp_restart_req;
bind field "CFE_SB_Global_t" "AppId" as value(CFE_SB_Global.AppId) prov sb_global_appid_field, sb_global_typedef;
bind field "EVS_AppData_t" "AppID" as state(evs.reg(rec)) prov evs_appdata_struct, evs_utils_ismatch;
site app_create_clear = fn("CFE_ES_AppCreate").call("memset") prov es_appcreate_clear;
site core_clear = fn("CFE_ES_CreateObjects").call("memset") prov es_start_clear;
site core_phase2_begin = fn("CFE_ES_CreateObjects").call("CFE_ES_LockSharedData") nth 1 prov es_start_phase2_begin, r_phase_anchor;
site core_sync_call = fn("CFE_ES_CreateObjects").call("CFE_ES_MainTaskSyncDelay") prov es_start_sync_call;
site sb_publication = fn("CFE_SB_AppInit").call("CFE_ES_GetAppID", arg[0] is addr(CFE_SB_Global_t.AppId)) prov sb_appinit_getappid;
op CFE_ES_AppCreate(out ApplicationIdPtr, AppName, Params) {
  bind symbol "CFE_ES_AppCreate";
  effect clear_ext_state: lifecycle es.appstate(es.app(lp.slot)) -> UNDEFINED lp site app_create_clear values slot: Int prov es_appcreate_clear;
  effect clear_ext_type: settag Type of es.app(lp.slot) := UNSET lp site app_create_clear values slot: Int prov es_appcreate_clear;
  effect free_external: lifecycle es.app(lp.slot) -> FREE id CFE_RESOURCEID_UNDEFINED lp at fn("CFE_ES_AppCreate").call("CFE_ES_AppRecordSetFree") values slot: Int prov es_appcreate_fail;
  effect publish_external: lifecycle es.app(lp.slot) -> LIVE id lp.pending_id lp at fn("CFE_ES_AppCreate").call("CFE_ES_AppRecordSetUsed", arg[1] != CFE_RESOURCEID_RESERVED) values slot: Int, pending_id: Id<es.app> prov es_appcreate_publish;
  effect reserve_external: lifecycle es.app(lp.slot) -> RESERVED id CFE_RESOURCEID_RESERVED lp at fn("CFE_ES_AppCreate").call("CFE_ES_AppRecordSetUsed", arg[1] == CFE_RESOURCEID_RESERVED) values slot: Int prov es_appcreate_reserve;
  effect type_external: settag Type of es.app(lp.slot) := EXTERNAL lp at fn("CFE_ES_AppCreate").store(CFE_ES_AppRecord_t.Type) values slot: Int prov es_appcreate_type;
  prov es_appcreate_fn;
}
op CFE_ES_CleanUpApp(AppId) {
  bind symbol "CFE_ES_CleanUpApp";
  effect free_record: lifecycle es.app(lp.slot) -> FREE id CFE_RESOURCEID_UNDEFINED when state(es.app(lp.slot)) = RESERVED lp at fn("CFE_ES_CleanUpApp").call("CFE_ES_AppRecordSetFree") values slot: Int prov es_apps_cleanup_free;
  effect retire: lifecycle es.app(lp.slot) -> RESERVED id CFE_RESOURCEID_RESERVED when state(es.app(lp.slot)) = LIVE && tag(es.app(lp.slot), Type) = EXTERNAL && state(es.appstate(es.app(lp.slot))) > RUNNING lp at fn("CFE_ES_CleanUpApp").call("CFE_ES_AppRecordSetUsed", arg[1] == CFE_RESOURCEID_RESERVED) values slot: Int status declared_trusted refutable_by O3, O4 prov es_apps_cleanup_match, es_apps_cleanup_retire, es_apps_scan_filter, r_cleanup_guard;
  prov es_apps_cleanup_free, es_apps_cleanup_retire, es_cleanupapp_fn;
}
op CFE_ES_CreateObjects() {
  bind symbol "CFE_ES_CreateObjects";
  effect clear_core: lifecycle es.app(lp.slot) -> FREE id CFE_RESOURCEID_UNDEFINED lp site core_clear values slot: Int prov es_start_clear;
  effect clear_core_state: lifecycle es.appstate(es.app(lp.slot)) -> UNDEFINED lp site core_clear values slot: Int prov es_start_clear;
  effect clear_core_type: settag Type of es.app(lp.slot) := UNSET lp site core_clear values slot: Int prov es_start_clear;
  effect publish_core: lifecycle es.app(lp.slot) -> LIVE id lp.pending_id lp at fn("CFE_ES_CreateObjects").call("CFE_ES_AppRecordSetUsed", arg[1] != CFE_RESOURCEID_RESERVED) values slot: Int, pending_id: Id<es.app> prov es_start_publish, es_start_starttask;
  effect reserve_core: lifecycle es.app(lp.slot) -> RESERVED id CFE_RESOURCEID_RESERVED lp at fn("CFE_ES_CreateObjects").call("CFE_ES_AppRecordSetUsed", arg[1] == CFE_RESOURCEID_RESERVED) values slot: Int prov es_start_reserve;
  effect type_core: settag Type of es.app(lp.slot) := CORE lp at fn("CFE_ES_CreateObjects").store(CFE_ES_AppRecord_t.Type) values slot: Int prov es_start_type_core;
  prov es_createobjects_fn, es_start_earlyinit_loop, es_start_taskmain_loop;
}
op CFE_ES_ExitApp(ExitStatus) {
  bind symbol "CFE_ES_ExitApp";
  effect stop_external: lifecycle es.appstate(owner(exec)) -> STOPPED when state(es.self(exec)) = LIVE && tag(owner(exec), Type) != CORE lp at fn("CFE_ES_ExitApp").store(CFE_ES_AppRecord_t.AppState) prov es_api_exitapp_ctx, es_api_exitapp_stopped;
  prov es_api_exitapp_stopped;
}
op CFE_ES_GetAppID(out AppIdPtr) {
  bind symbol "CFE_ES_GetAppID";
  conjunct self_live: state(es.self(exec)) = LIVE lp at fn("CFE_ES_GetAppID").call("CFE_ES_GetAppRecordByContext");
  effect store_fail: store *AppIdPtr := CFE_RESOURCEID_UNDEFINED filter state(es.self(exec)) != LIVE lp at fn("CFE_ES_GetAppID").call("CFE_ES_UnlockSharedData") prov es_getappid_fail, r_lp_store_via_unlock;
  effect store_ok: store *AppIdPtr := id(owner(exec)) when state(es.self(exec)) = LIVE lp at fn("CFE_ES_GetAppID").call("CFE_ES_AppRecordGetID") prov es_getappid_ok, sb_appinit_getappid;
  outcome CFE_ES_BAD_ARGUMENT: error documented "retval CFE_ES_BAD_ARGUMENT of CFE_ES_GetAppID (cfe_es.h:520): the out pointer is NULL" prov es_h_getappid_doc;
  outcome CFE_ES_ERR_RESOURCEID_NOT_VALID: not_ready(self_live) documented "retval CFE_ES_ERR_RESOURCEID_NOT_VALID of CFE_ES_GetAppID (cfe_es.h:519); the out parameter is documented as set to the application ID of the caller" prov es_h_getappid_doc;
  outcome CFE_SUCCESS: ready;
  prov es_ctx_lookup, es_getappid_ctx, es_getappid_fn, sb_appinit_getappid;
}
op CFE_ES_Main(StartType, StartSubtype, ModeId, StartFilePath) {
  bind symbol "CFE_ES_Main";
  effect reset_records: lifecycle all es.app -> FREE lp at fn("CFE_ES_Main").memset(CFE_ES_Global_t) prov es_start_main_memset;
  effect reset_states: lifecycle all es.appstate -> UNDEFINED lp at fn("CFE_ES_Main").memset(CFE_ES_Global_t) prov es_start_main_memset;
  prov es_main_fn, es_start_main_memset;
}
op CFE_ES_MainTaskSyncDelay(AppStateId, TimeOutMilliseconds) {
  bind symbol "CFE_ES_MainTaskSyncDelay";
  outcome CFE_ES_OPERATION_TIMED_OUT: error;
  outcome CFE_SUCCESS: ready;
  prov es_start_syncdelay_fn, es_start_table_loop;
}
op CFE_ES_RunAppTableScan(ElapsedTime, Arg) {
  bind symbol "CFE_ES_RunAppTableScan";
  effect wait_external: lifecycle es.appstate(es.app(lp.slot)) -> WAITING when state(es.appstate(es.app(lp.slot))) = RUNNING && tag(es.app(lp.slot), Type) = EXTERNAL lp at fn("CFE_ES_RunAppTableScan").store(CFE_ES_AppRecord_t.AppState) values slot: Int prov es_apps_scan_filter, es_apps_scan_waiting;
  prov es_apps_scan_waiting, es_runapptablescan_fn;
}
op CFE_ES_RunLoop(RunStatus) {
  bind symbol "CFE_ES_RunLoop";
  effect raise_running: lifecycle es.appstate(owner(exec)) raise RUNNING when state(es.self(exec)) = LIVE lp at fn("CFE_ES_RunLoop").store(CFE_ES_AppRecord_t.AppState) prov es_api_runloop_raise;
  prov es_api_runloop_raise, es_runloop_fn;
}
op CFE_ES_WaitForSystemState(MinSystemState, TimeOutMilliseconds) {
  bind symbol "CFE_ES_WaitForSystemState";
  effect raise_state: lifecycle es.appstate(owner(exec)) raise lp.required when state(es.self(exec)) = LIVE lp at fn("CFE_ES_WaitForSystemState").store(CFE_ES_AppRecord_t.AppState) values required: Int prov es_api_wait_fn, es_api_wait_levels;
  outcome CFE_ES_OPERATION_TIMED_OUT: error;
  outcome CFE_SUCCESS: ready;
  prov es_api_wait_fn;
}
op CFE_EVS_Register(Filters, NumEventFilters, FilterScheme) {
  bind symbol "CFE_EVS_Register";
  effect clear_slot: lifecycle evs.reg(id(owner(exec))) -> UNREG lp at fn("CFE_EVS_Register").memset(EVS_AppData_t) prov evs_reg_memset;
  effect register: lifecycle evs.reg(id(owner(exec))) -> REG lp at fn("CFE_EVS_Register").call("EVS_AppDataSetUsed") prov evs_reg_publish, evs_utils_setused;
  outcome CFE_ES_BAD_ARGUMENT: error;
  outcome CFE_EVS_APP_ILLEGAL_APP_ID: error;
  outcome CFE_EVS_UNKNOWN_FILTER: error;
  outcome CFE_SUCCESS: ready;
  prov evs_reg_memset, evs_reg_publish, evs_register_fn;
}
op CFE_EVS_SendEventWithAppID(EventID, EventType, stamp AppID: Id<es.app>, Spec) {
  bind symbol "CFE_EVS_SendEventWithAppID";
  conjunct id_valid: valid(arg.AppID) lp capture prov es_appid_toindex_fn, evs_utils_getbyid, resid_toindex_fn;
  conjunct slot_registered: state(evs.reg(arg.AppID)) = REG lp at fn("CFE_EVS_SendEventWithAppID").call("EVS_AppDataIsMatch") prov evs_send_check, evs_utils_ismatch;
  outcome CFE_EVS_APP_ILLEGAL_APP_ID: not_ready(id_valid) documented "retval CFE_EVS_APP_ILLEGAL_APP_ID of CFE_EVS_SendEventWithAppID; the code returns it before it builds any event packet" prov evs_h_retval;
  outcome CFE_EVS_APP_NOT_REGISTERED: not_ready(slot_registered) documented "retval CFE_EVS_APP_NOT_REGISTERED of CFE_EVS_SendEventWithAppID" prov evs_h_retval;
  outcome CFE_EVS_APP_SQUELCHED: ready;
  outcome CFE_EVS_INVALID_PARAMETER: error;
  outcome CFE_SUCCESS: ready;
  prov evs_send_check, evs_send_fn, evs_send_squelch, evs_utils_getbyid, evs_utils_ismatch, sb_api_event_site;
}
op CFE_PSP_Panic(ErrorCode) {
  bind symbol "CFE_PSP_Panic";
  terminal process_terminal after fn("CFE_PSP_Panic").call("abort");
  prov psp_panic_fn;
}
op CFE_PSP_Restart(resetType) {
  bind symbol "CFE_PSP_Restart";
  effect request_shutdown: lifecycle es.shutdown() -> SHUTDOWN_REQ lp at fn("CFE_PSP_Restart").store(CFE_PSP_IdleTaskState_t.ShutdownReq) prov psp_restart_req;
  terminal process_terminal after fn("CFE_PSP_Restart").call("abort");
  prov psp_restart_abort, psp_restart_fn;
}
op CFE_SB_EarlyInit() {
  bind symbol "CFE_SB_EarlyInit";
  effect clear_global: store CFE_SB_Global.AppId := CFE_RESOURCEID_UNDEFINED lp at fn("CFE_SB_EarlyInit").memset(CFE_SB_Global_t) prov sb_earlyinit_memset;
  prov sb_earlyinit_fn, sb_earlyinit_memset;
}
op OS_Application_Run() {
  bind symbol "OS_Application_Run";
  effect teardown: lifecycle es.shutdown() -> TEARDOWN lp at fn("OS_Application_Run").call("OS_DeleteAllObjects") prov psp_teardown;
  prov psp_app_run_fn, psp_teardown;
}
op OS_TaskCreate(out task_id, task_name, function_pointer, stack_pointer, stack_size, priority, flags) {
  bind symbol "OS_TaskCreate";
  prov es_apps_startapptask_create, osal_pthread_create;
}
op OS_TaskEntryPoint(task_id) {
  bind symbol "OS_TaskEntryPoint";
  prov osal_entrypoint;
}
op abort() {
  bind symbol "abort";
  terminal process_terminal;
  prov r_libc_abort;
}
op main(argc, argv) {
  bind symbol "main";
  terminal process_terminal after fn("main").return;
  prov bsp_main_fn, bsp_main_return;
}
init sb_identity_image: loc CFE_SB_Global.AppId = CFE_RESOURCEID_UNDEFINED prov sb_global_def note "global object without an initializer: zero, i.e. CFE_ES_APPID_UNDEFINED";
hb R1 {
  title "program order";
  stratum S;
  robust unconditional;
  template program_order {
    looper yes;
  }
  prov r_axiom_program_order;
}
hb R18 {
  title "EarlyInit precedes every task";
  stratum S;
  robust unconditional;
  template phase {
    from core_phase2_begin phase point;
  }
  note "anchored at the first LockSharedData of the second loop: the EarlyInit calls are indirect calls the pattern language cannot name";
  prov es_start_earlyinit_loop, es_start_taskmain_loop, r_phase_anchor;
}
hb R19 {
  title "CORE-SERIAL";
  stratum S;
  robust obs_fatal;
  template observe {
    poll "CFE_ES_MainTaskSyncDelay" called_at fn("CFE_ES_CreateObjects").call("CFE_ES_MainTaskSyncDelay");
    exit_outcome CFE_SUCCESS;
    predicate from_code;
    else_terminal "CFE_PSP_Panic";
    watch es.app, es.appstate;
  }
  guard cfe >= "6.4.2";
  note "the predicate is extracted from the loop at cfe_es_start.c:878-890: no used record has AppState below the awaited state; the guard is the SPEC's, not re-verified";
  prov es_start_panic, es_start_sync_call, es_start_syncdelay_fn, es_start_table_loop, es_start_taskmain_loop, r_guard_core_serial;
}
hb R2-P-TASK {
  title "task creation: the creating call precedes the first event of the child";
  stratum S;
  robust unconditional;
  template spawn {
    create OS_TaskCreate out task_id;
    entry OS_TaskEntryPoint;
  }
  prov es_apps_startapptask_create, osal_entrypoint, osal_pthread_create;
}
rspec K-ID.send-with-appid {
  use op CFE_EVS_SendEventWithAppID;
  key evs.reg(arg.AppID);
  requires valid(arg.AppID) && state(evs.reg(arg.AppID)) = REG;
  oracle fns "EVS_AppDataIsMatch", "EVS_GetAppDataByID";
  appreq evs_h_appid_note;
  allowed none;
  harm event_request_rejected;
  authored "2026-10-15, K1 (Claude Sonnet 5.5), from SPEC_FINAL 1.6, 2.3 and A.1 and the pinned source; cases inspected for this API: R2";
  prov evs_h_appid_note, evs_h_retval, evs_send_check, evs_utils_getbyid, evs_utils_ismatch;
}
trusted A-FRESH {
  class declared_trusted;
  statement "Distinct reservation nodes of the core creation loop allocate distinct App records, and a record allocated there was never used earlier in the run";
  refutable_by O9;
  prov es_start_reserve, es_start_taskmain_loop, r_a_fresh;
}
trusted A-OWNER {
  class declared_trusted;
  statement "The App record that CFE_ES_GetAppRecordByContext returns for a task created by StartAppTask with ParentAppId is the record whose PendingAppId flowed to ParentAppId";
  refutable_by O9;
  prov es_apps_taskrecord_fill, es_ctx_lookup, es_start_starttask, r_a_owner;
}
