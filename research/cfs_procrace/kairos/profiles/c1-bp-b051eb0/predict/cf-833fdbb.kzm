# cf-833fdbb.kzm -- the CF main task at CF 833fdbb (the fix of #184) in the predict model of profile c1-bp-b051eb0.
# Read after 00_common.kzm, with the profile directory cf-833fdbb/ (the retry constants are values of this revision only).
#
# CF_CFDP_InitEngine (cf_cfdp.c L991-L1021): for each channel in order (L967; CF_NUM_CHANNELS 2) with a configured
# name, up to CF_STARTUP_SEM_MAX_RETRIES lookups; a result other than OS_ERR_NAME_NOT_FOUND ends the loop; after each
# OS_ERR_NAME_NOT_FOUND, OS_TaskDelay(CF_STARTUP_SEM_TASK_DELAY), also after the last one (L1000-L1012).  After the loop
# a result other than OS_SUCCESS: event 30 and break out of the channel loop (L1014-L1019).  CF_Init returns the status
# (cf_app.c L250-L258); a failed CF_Init sets run_status APP_ERROR (L330-L334), CFE_ES_RunLoop then returns false at
# once and CF_AppMain calls CFE_ES_ExitApp(run_status) (L336-L338, L366).  The delay has no duration in the model.
kzp-predict 1

program CF
  event CF_Init call prov cf_app_init_status
  event CF_CFDP_InitEngine call prov cf_app_init_engine_call
  counter j reset prov cf_cfdp_retry_loop
  label try0
  use OS_CountSemGetIdByName s0 role-site cf_lookup_call prov cf_cfdp_lookup_call, cf_cfdp_retry_loop, m_cf_channel_loop, m_cf_num_channels
    hit osal.countsem_lookup.entry before caller cf.so name sem_name
    hit cf_lookup_call after
  unless-result OS_ERR_NAME_NOT_FOUND done0 prov cf_cfdp_retry_loop
  event cf_retry_delay pt prov cf_cfdp_retry_loop, cf_platform_delay
    hit cf_retry_delay after
  counter j inc prov cf_cfdp_retry_loop
  if-below j CF_STARTUP_SEM_MAX_RETRIES try0 prov cf_cfdp_retry_loop, cf_platform_retries
  label done0
  unless-result OS_SUCCESS fail prov cf_cfdp_fail_event
  counter j reset prov cf_cfdp_retry_loop
  label try1
  use OS_CountSemGetIdByName s1 role-site cf_lookup_call prov cf_cfdp_lookup_call, cf_cfdp_retry_loop, m_cf_channel_loop, m_cf_num_channels
    hit osal.countsem_lookup.entry before caller cf.so name sem_name
    hit cf_lookup_call after
  unless-result OS_ERR_NAME_NOT_FOUND done1 prov cf_cfdp_retry_loop
  event cf_retry_delay pt prov cf_cfdp_retry_loop, cf_platform_delay
    hit cf_retry_delay after
  counter j inc prov cf_cfdp_retry_loop
  if-below j CF_STARTUP_SEM_MAX_RETRIES try1 prov cf_cfdp_retry_loop, cf_platform_retries
  label done1
  unless-result OS_SUCCESS fail prov cf_cfdp_fail_event
  event CF_CFDP_InitEngine ret result=OS_SUCCESS prov cf_cfdp_initengine_return
  event CF_Init ret result=OS_SUCCESS prov m_cf_init_success
  mark "event 20 CF Initialized; CF enters its main loop (outside the cone)"
  finish prov m_cf_init_success, m_cf_runloop
  label fail
  mark "event 30 failed to get sem id; break out of the channel loop"
  event CF_CFDP_InitEngine ret result=OS_ERR_NAME_NOT_FOUND prov cf_cfdp_fail_event, cf_cfdp_initengine_return
  event CF_Init ret result=OS_ERR_NAME_NOT_FOUND prov m_cf_init_success
  mark "run_status APP_ERROR; CFE_ES_RunLoop returns false"
  exit CFE_ES_ExitApp CFE_ES_RunStatus_APP_ERROR prov cf_app_init_status, m_cf_runloop, m_es_runloop_false, cf_app_exit, es_exitapp_external
    hit es.exit_app.entry before caller cf.so
end
